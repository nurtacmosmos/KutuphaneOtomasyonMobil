<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#DCDCDC">

    <!-- TITLE -->

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KÜTÜPHANE OTOMASYONU"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <!-- TOP INFO -->

    <!-- TABLE AREA -->

    <LinearLayout
        android:layout_width="363dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- BOOK COUNT -->

        <TextView
            android:id="@+id/lblBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toplam Kitap : 3"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="80dp"
            android:layout_height="wrap_content" />

        <!-- MEMBER COUNT -->

        <TextView
            android:id="@+id/lblMember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Üye Sayısı : 1"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="#FFFFFF"
        android:stretchColumns="*">

        <!-- HEADER -->

        <TableRow
            android:background="#DDDDDD">

            <TextView
                android:text="Kitap"
                android:textStyle="bold"
                android:padding="8dp"/>

            <TextView
                android:text="Yazar"
                android:textStyle="bold"
                android:padding="8dp"/>

        </TableRow>

        <!-- ROW 1 -->

        <TableRow>

            <TextView
                android:text="1984"
                android:padding="8dp"/>

            <TextView
                android:text="Orwell"
                android:padding="8dp"/>

        </TableRow>

        <!-- ROW 2 -->

        <TableRow
            android:background="#EEEEEE">

            <TextView
                android:text="Suç Ve Ceza"
                android:padding="8dp"/>

            <TextView
                android:text="Dostoyevski"
                android:padding="8dp"/>

        </TableRow>

        <!-- ROW 3 -->

        <TableRow>

            <TextView
                android:text="Simyacı"
                android:padding="8dp"/>

            <TextView
                android:text="Paulo Coelho"
                android:padding="8dp"/>

        </TableRow>

    </TableLayout>

    <!-- BUTTON -->

    <Button
        android:id="@+id/btnDetail"
        android:layout_width="120dp"
        android:layout_height="55dp"
        android:text="DETAY"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="120dp"
        android:backgroundTint="#FFFFFF"/>

</LinearLayout>